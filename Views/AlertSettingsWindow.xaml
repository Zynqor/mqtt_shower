<Window x:Class="MqttMonitor.Views.AlertSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource AlertSettings.WindowTitle}" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F8F9FA">
    <Border Margin="15" Background="White" CornerRadius="8" Padding="20"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{DynamicResource AlertSettings.Title}" FontSize="18" FontWeight="Bold"
                       Foreground="#212529" Margin="0,0,0,20"/>

            <!-- 设置表单 -->
            <StackPanel Grid.Row="1">
                <!-- 声音设置 -->
                <GroupBox Header="{DynamicResource AlertSettings.SoundSettings}" Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <CheckBox Content="{DynamicResource AlertSettings.EnableSound}" IsChecked="{Binding SoundEnabled}"
                                  Style="{StaticResource ModernCheckBox}"
                                  FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Label Content="{DynamicResource AlertSettings.Volume}" Style="{StaticResource ModernLabel}"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Value="{Binding SoundVolume}" Minimum="0" Maximum="100"
                                    Style="{StaticResource ModernSlider}"
                                    TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SoundVolume, StringFormat={}{0}%}"
                                       Width="50" TextAlignment="Right" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="13" Margin="15,0,0,0"/>
                        </Grid>

                        <Separator Style="{StaticResource ModernSeparator}"/>

                        <CheckBox Content="{DynamicResource AlertSettings.RepeatSound}" IsChecked="{Binding RepeatSound}"
                                  Style="{StaticResource ModernCheckBox}" Margin="0,10,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="{DynamicResource AlertSettings.DefaultRepeatInterval}" Style="{StaticResource ModernLabel}"
                                   VerticalAlignment="Center" Width="120"/>
                            <TextBox Grid.Column="1" Text="{Binding DefaultRepeatMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource AlertSettings.Minutes}" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#495057" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource AlertSettings.RepeatHint}"
                                   Foreground="#6C757D" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- 音效测试 -->
                <GroupBox Header="{DynamicResource AlertSettings.SoundTest}" Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource AlertSettings.SoundTestHint}"
                                   Foreground="#6C757D" FontSize="11" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{DynamicResource AlertSettings.TestAlarm}" Command="{Binding TestAlarmSoundCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Width="130" Margin="0,0,10,0"/>
                            <Button Content="{DynamicResource AlertSettings.TestRecovery}" Command="{Binding TestRecoverySoundCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    Width="130"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource AlertSettings.CustomSoundHint}"
                                   Foreground="#007BFF" FontSize="11" Margin="0,15,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource Settings.Save}" Width="90" Command="{Binding SaveCommand}"
                        Style="{StaticResource SuccessButton}"
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Settings.Cancel}" Width="90" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
