<Window x:Class="MqttMonitor.Views.AlarmHistoryQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MqttMonitor.Converters"
        mc:Ignorable="d"
        Title="{DynamicResource AlarmHistoryQuery.WindowTitle}" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <!-- 资源 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询条件区域 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- 设备选择 -->
                <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource AlarmHistoryQuery.SelectDevice}" VerticalAlignment="Center"
                       Style="{StaticResource ModernLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,10,0"/>
                <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource AlarmHistoryQuery.RefreshDevices}"
                        Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource SecondaryButton}"/>

                <!-- 告警类型选择 -->
                <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource AlarmHistoryQuery.AlarmType}" VerticalAlignment="Center"
                       Style="{StaticResource ModernLabel}" Margin="0,15,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          ItemsSource="{Binding AlarmTypes}"
                          SelectedItem="{Binding SelectedAlarmType}"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,15,0,0"/>

                <!-- 开始时间 -->
                <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource AlarmHistoryQuery.StartTime}" VerticalAlignment="Center"
                       Style="{StaticResource ModernLabel}" Margin="0,15,0,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <DatePicker SelectedDate="{Binding StartDateTime, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernDatePicker}"
                                Width="200" Margin="0,0,10,0"/>
                    <Label Content="{DynamicResource AlarmHistoryQuery.TimeLabel}" VerticalAlignment="Center" Style="{StaticResource ModernLabel}" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding StartDateTime, StringFormat='HH:mm:ss', UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource ModernTextBox}"
                             Width="100"/>
                </StackPanel>

                <!-- 结束时间 -->
                <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource AlarmHistoryQuery.EndTime}" VerticalAlignment="Center"
                       Style="{StaticResource ModernLabel}" Margin="0,15,0,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <DatePicker SelectedDate="{Binding EndDateTime, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernDatePicker}"
                                Width="200" Margin="0,0,10,0"/>
                    <Label Content="{DynamicResource AlarmHistoryQuery.TimeLabel}" VerticalAlignment="Center" Style="{StaticResource ModernLabel}" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding EndDateTime, StringFormat='HH:mm:ss', UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource ModernTextBox}"
                             Width="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据显示区域 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <!-- 加载指示器 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="200" Height="20" IsIndeterminate="True"/>
                    <TextBlock Text="{DynamicResource AlarmHistoryQuery.Loading}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 数据表格 -->
                <DataGrid x:Name="AlarmDataGrid"
                          ItemsSource="{Binding AlarmRecords}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#F8F9FA"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          Visibility="{Binding IsLoading, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding TriggerTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.TriggerTime}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DeviceId}" Width="120">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.DeviceId}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding MetricName}" Width="120">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.MetricName}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="100">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.AlarmTypeColumn}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="AlarmType">
                                    <Binding.Converter>
                                        <converters:AlarmTypeToTextConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TriggerValue, StringFormat='{}{0:F2}'}" Width="80">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.TriggerValue}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ThresholdValue, StringFormat='{}{0:F2}'}" Width="80">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.Threshold}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Unit}" Width="60">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.Unit}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RecoveredTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.RecoveryTime}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="80">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource AlarmHistoryQuery.StatusColumn}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Status">
                                    <Binding.Converter>
                                        <converters:AlarmStatusToTextConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 操作按钮区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 状态栏 -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="10"
                    BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
            </Border>

            <!-- 按钮组 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource AlarmHistoryQuery.Query}" Width="100" Margin="0,0,10,0"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding QueryCommand}"/>
                <Button Content="{DynamicResource AlarmHistoryQuery.ExportCSV}" Width="100"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
