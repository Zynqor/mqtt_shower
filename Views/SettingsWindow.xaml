<Window x:Class="MqttMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MqttMonitor.Converters"
        mc:Ignorable="d"
        Title="{DynamicResource Settings.WindowTitle}" Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
    </Window.Resources>
    <Border Margin="15" Background="White" CornerRadius="8" Padding="20"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{DynamicResource Settings.Title}"
                       FontSize="18" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,20"/>

            <!-- 设置表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 服务器地址 -->
                    <Label Content="{DynamicResource Settings.Server}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                    <!-- 端口 -->
                    <Label Content="{DynamicResource Settings.Port}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                    <!-- 用户名 -->
                    <Label Content="{DynamicResource Settings.Username}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                    <!-- 密码 -->
                    <Label Content="{DynamicResource Settings.Password}" Style="{StaticResource ModernLabel}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 隐藏密码的 PasswordBox -->
                        <PasswordBox Grid.Column="0" x:Name="PasswordBox"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                        <!-- 显示密码的 TextBox -->
                        <TextBox Grid.Column="0" x:Name="PasswordTextBox"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Content="👁"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                Style="{StaticResource LightButton}"
                                Width="36" Margin="5,0,0,0"
                                ToolTip="{DynamicResource Settings.PasswordToggle}"/>
                    </Grid>

                    <!-- 客户端ID -->
                    <Label Content="{DynamicResource Settings.ClientId}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                    <!-- 基础 Topic -->
                    <Label Content="{DynamicResource Settings.BaseTopic}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding BaseTopic, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,5"/>
                    <TextBlock Text="{DynamicResource Settings.BaseTopicHint}"
                               Foreground="#6C757D" FontSize="11" Margin="0,0,0,15"/>

                    <!-- TLS/SSL 配置分隔线 -->
                    <Separator Style="{StaticResource ModernSeparator}" Margin="0,10,0,15"/>
                    <TextBlock Text="{DynamicResource Settings.TlsConfig}" FontWeight="SemiBold" FontSize="15"
                               Foreground="#212529" Margin="0,0,0,15"/>

                    <!-- 启用 TLS -->
                    <CheckBox Content="{DynamicResource Settings.EnableTls}"
                              IsChecked="{Binding UseTls, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernCheckBox}"
                              FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <!-- CA 证书路径 -->
                    <Label Content="{DynamicResource Settings.CaCertPath}" Style="{StaticResource ModernLabel}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CaCertificatePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Settings.Browse}"
                                Command="{Binding BrowseCaCertCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="70" Margin="5,0,0,0"/>
                    </Grid>

                    <!-- 客户端证书路径 -->
                    <Label Content="{DynamicResource Settings.ClientCertPath}" Style="{StaticResource ModernLabel}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ClientCertificatePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Settings.Browse}"
                                Command="{Binding BrowseClientCertCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="70" Margin="5,0,0,0"/>
                    </Grid>

                    <!-- 客户端私钥路径 -->
                    <Label Content="{DynamicResource Settings.ClientKeyPath}" Style="{StaticResource ModernLabel}"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ClientKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"/>
                        <Button Grid.Column="1" Content="{DynamicResource Settings.Browse}"
                                Command="{Binding BrowseClientKeyCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Width="70" Margin="5,0,0,0"/>
                    </Grid>

                    <!-- 忽略证书错误 -->
                    <CheckBox Content="{DynamicResource Settings.IgnoreCertErrors}"
                              IsChecked="{Binding IgnoreCertificateErrors, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernCheckBox}"
                              Foreground="#DC3545" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource Settings.Save}" Width="90"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource SuccessButton}"
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Settings.Cancel}" Width="90"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
