<Window x:Class="MqttMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MqttMonitor.Converters"
        mc:Ignorable="d"
        Title="MQTT 连接设置" Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>

        <!-- PasswordBox样式 -->
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="MQTT 服务器连接配置"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- 设置表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 服务器地址 -->
                <Label Content="服务器地址:" FontWeight="Bold"/>
                <TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                         Height="42" Margin="0,0,0,10"/>

                <!-- 端口 -->
                <Label Content="端口:" FontWeight="Bold"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Height="42" Margin="0,0,0,10"/>

                <!-- 用户名 -->
                <Label Content="用户名 (可选):" FontWeight="Bold"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="42" Margin="0,0,0,10"/>

                <!-- 密码 -->
                <Label Content="密码 (可选):" FontWeight="Bold"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 隐藏密码的 PasswordBox -->
                    <PasswordBox Grid.Column="0" x:Name="PasswordBox"
                                 Height="42" Visibility="{Binding IsPasswordVisible, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                    <!-- 显示密码的 TextBox -->
                    <TextBox Grid.Column="0" x:Name="PasswordTextBox"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Grid.Column="1" Content="👁"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            Width="35" Height="25" Margin="5,0,0,0"
                            FontSize="14" ToolTip="显示/隐藏密码"/>
                </Grid>

                <!-- 客户端ID -->
                <Label Content="客户端ID (可选，留空则自动生成):" FontWeight="Bold"/>
                <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                         Height="42" Margin="0,0,0,10"/>

                <!-- 基础 Topic -->
                <Label Content="基础 Topic:" FontWeight="Bold"/>
                <TextBox Text="{Binding BaseTopic, UpdateSourceTrigger=PropertyChanged}"
                         Height="42" Margin="0,0,0,10"/>
                <TextBlock Text="用于命令发送和响应，例如: iot/devices"
                           Foreground="Gray" FontSize="11" Margin="0,-8,0,10"/>

                <!-- TLS/SSL 配置分隔线 -->
                <Separator Margin="0,10,0,10"/>
                <TextBlock Text="TLS/SSL 加密配置" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <!-- 启用 TLS -->
                <CheckBox Content="启用 TLS/SSL 加密连接 (通常使用8883端口)"
                          IsChecked="{Binding UseTls, UpdateSourceTrigger=PropertyChanged}"
                          FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- CA 证书路径 -->
                <Label Content="CA 证书路径 (用于验证服务器):" FontWeight="Bold"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding CaCertificatePath, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"/>
                    <Button Grid.Column="1" Content="浏览..."
                            Command="{Binding BrowseCaCertCommand}"
                            Width="70" Height="30" Margin="5,0,0,0"/>
                </Grid>

                <!-- 客户端证书路径 -->
                <Label Content="客户端证书路径 (可选，双向认证时使用):" FontWeight="Bold"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ClientCertificatePath, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"/>
                    <Button Grid.Column="1" Content="浏览..."
                            Command="{Binding BrowseClientCertCommand}"
                            Width="70" Height="30" Margin="5,0,0,0"/>
                </Grid>

                <!-- 客户端私钥路径 -->
                <Label Content="客户端私钥路径 (可选，双向认证时使用):" FontWeight="Bold"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding ClientKeyPath, UpdateSourceTrigger=PropertyChanged}"
                             Height="42"/>
                    <Button Grid.Column="1" Content="浏览..."
                            Command="{Binding BrowseClientKeyCommand}"
                            Width="70" Height="30" Margin="5,0,0,0"/>
                </Grid>

                <!-- 忽略证书错误 -->
                <CheckBox Content="忽略证书错误 (仅用于测试，不推荐生产环境使用)"
                          IsChecked="{Binding IgnoreCertificateErrors, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="#DC3545" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="保存" Width="80" Height="30"
                    Command="{Binding SaveCommand}"
                    Margin="0,0,10,0"/>
            <Button Content="取消" Width="80" Height="30"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
