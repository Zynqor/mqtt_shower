<UserControl x:Class="MqttMonitor.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MqttMonitor.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <UserControl.Resources>
        <converters:GroupIndexToBackgroundConverter x:Key="GroupIndexToBackgroundConverter"/>
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="15,12" CornerRadius="8,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1,1,1,0">
            <TextBlock Text="{DynamicResource Table.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#212529"/>
        </Border>

        <!-- 数据表格 -->
        <Border Grid.Row="1" Background="White" CornerRadius="0,0,8,8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding DeviceDisplayItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 每个设备 -->
                            <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,2" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- 设备ID行 -->
                                    <Border Background="#F8F9FA" Padding="12,10" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DeviceId}" FontWeight="Bold" FontSize="13" Foreground="#212529"/>
                                            <TextBlock Grid.Column="2" FontSize="11" Foreground="#6C757D" VerticalAlignment="Center">
                                                <Run Text="{DynamicResource Table.LastUpdate}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding LastUpdateTime, Converter={StaticResource DateTimeToStringConverter}}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- 数据行组 -->
                                    <ItemsControl ItemsSource="{Binding DataRowGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <!-- 表头行 -->
                                                    <Grid Height="35">
                                                        <Grid.Background>
                                                            <Binding Path="GroupIndex" Converter="{StaticResource GroupIndexToBackgroundConverter}" ConverterParameter="header"/>
                                                        </Grid.Background>
                                                        <ItemsControl ItemsSource="{Binding Metrics}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#DEE2E6" BorderThickness="0,0,1,0" Padding="12,8">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                   FontSize="12" Foreground="#495057"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <!-- 数据行 -->
                                                    <Grid Height="35">
                                                        <Grid.Background>
                                                            <Binding Path="GroupIndex" Converter="{StaticResource GroupIndexToBackgroundConverter}" ConverterParameter="data"/>
                                                        </Grid.Background>
                                                        <ItemsControl ItemsSource="{Binding Metrics}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#DEE2E6" BorderThickness="0,0,1,0" Padding="12,8">
                                                                        <TextBlock Text="{Binding Value}" FontSize="12" Foreground="#212529"/>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>

                                                    <!-- 组之间的分割线 -->
                                                    <Border BorderBrush="#ADB5BD" BorderThickness="0,0,0,2" Margin="0,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
