<UserControl x:Class="MqttMonitor.Views.AlarmStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:local="clr-namespace:MqttMonitor.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 时间选择器 -->
        <GroupBox Grid.Row="0" Header="时间范围" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <!-- 快捷按钮 -->
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="今天" Command="{Binding SetTodayCommand}"
                            Width="60" Height="28" Margin="0,0,5,0"/>
                    <Button Content="最近7天" Command="{Binding SetLast7DaysCommand}"
                            Width="70" Height="28" Margin="0,0,5,0"/>
                    <Button Content="最近30天" Command="{Binding SetLast30DaysCommand}"
                            Width="80" Height="28"/>
                </WrapPanel>

                <!-- 自定义时间范围 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="开始时间：" VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding StartTime}" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="结束时间：" VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding EndTime}" Margin="0,0,0,5"/>

                    <Button Grid.Row="2" Grid.Column="1" Content="查询" Command="{Binding QueryCommand}"
                            Width="80" Height="30" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                </Grid>

                <!-- 加载指示 -->
                <TextBlock Text="正在加载统计数据..." Foreground="Gray"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 统计图表TabControl -->
        <TabControl Grid.Row="1">
            <!-- Tab1: 柱状图 - 告警次数 -->
            <TabItem Header="告警次数">
                <Grid>
                    <scottplot:WpfPlot x:Name="AlarmCountChart" Margin="10"/>
                    <TextBlock Text="暂无数据" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="Gray"
                               Visibility="{Binding AlarmCounts.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Tab2: 折线图 - 告警趋势 -->
            <TabItem Header="告警趋势">
                <Grid>
                    <scottplot:WpfPlot x:Name="AlarmTrendChart" Margin="10"/>
                    <TextBlock Text="暂无数据" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="Gray"
                               Visibility="{Binding AlarmTrends.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Tab3: 饼图 - 告警类型分布 -->
            <TabItem Header="类型分布">
                <Grid>
                    <scottplot:WpfPlot x:Name="AlarmTypeChart" Margin="10"/>
                    <TextBlock Text="暂无数据" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="Gray"
                               Visibility="{Binding AlarmTypeDistributions.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- Tab4: 表格 - Top告警设备 -->
            <TabItem Header="Top设备">
                <ScrollViewer>
                    <DataGrid ItemsSource="{Binding TopAlarmDevices}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FA"
                              Margin="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="60"/>
                            <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="*"/>
                            <DataGridTextColumn Header="测点名称" Binding="{Binding MetricName}" Width="*"/>
                            <DataGridTextColumn Header="告警次数" Binding="{Binding AlarmCount}" Width="80"/>
                            <DataGridTextColumn Header="平均持续" Binding="{Binding AvgDuration}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
