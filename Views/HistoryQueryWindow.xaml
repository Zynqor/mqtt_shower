<Window x:Class="MqttMonitor.Views.HistoryQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MqttMonitor.Converters"
        mc:Ignorable="d"
        Title="历史数据查询" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <!-- 资源 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>

        <!-- 按钮样式 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004085"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Foreground" Value="#666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4E555B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询条件区域 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <!-- 设备选择 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="选择设备:" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="13"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          Height="36" FontSize="13" Margin="0,0,10,0"
                          VerticalContentAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="2" Content="刷新设备"
                        Command="{Binding RefreshDevicesCommand}"
                        Style="{StaticResource SecondaryButton}" Height="36"/>

                <!-- 开始日期 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="开始日期:" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="13" Margin="0,15,0,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            SelectedDate="{Binding StartDate}"
                            Height="36" FontSize="13" Margin="0,15,0,0"
                            VerticalContentAlignment="Center"/>

                <!-- 结束日期 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="结束日期:" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="13" Margin="0,15,0,0"/>
                <DatePicker Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                            SelectedDate="{Binding EndDate}"
                            Height="36" FontSize="13" Margin="0,15,0,0"
                            VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 数据显示区域 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <!-- 加载指示器 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Width="200" Height="20" IsIndeterminate="True"/>
                    <TextBlock Text="正在加载数据..." FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 数据表格 -->
                <DataGrid x:Name="HistoryDataGrid"
                          ItemsSource="{Binding HistoryData}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#F8F9FA"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          Visibility="{Binding IsLoading, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 操作按钮区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 状态栏 -->
            <Border Grid.Column="0" Background="White" CornerRadius="4" Padding="10"
                    BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"/>
            </Border>

            <!-- 按钮组 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="查询" Width="100" Margin="0,0,10,0"
                        Style="{StaticResource ModernButton}"
                        Command="{Binding QueryCommand}"/>
                <Button Content="导出CSV" Width="100"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
