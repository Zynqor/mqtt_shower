<Window x:Class="MqttMonitor.Views.DeviceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设备管理" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Window.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004085"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Foreground" Value="#666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid样式 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#495057"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E9ECEF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E9FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="设备管理" FontSize="18" FontWeight="Bold"
                           Foreground="#212529" Margin="0,0,0,5"/>
                <TextBlock Text="自动发现和管理通过心跳上报的IoT设备"
                           FontSize="12" Foreground="#6C757D"/>
            </StackPanel>

            <Button Grid.Column="1" Content="刷新" Width="80" Height="35"
                    Style="{StaticResource ModernButton}"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- 统计信息 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6"
                Padding="15" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 设备统计 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatisticsText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#495057" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Width="1" Background="#E0E0E0" Margin="10,0"/>

                <!-- 心跳配置 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="心跳超时:" FontSize="12" Foreground="#6C757D"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding HeartbeatTimeoutSeconds}" FontSize="12"
                               FontWeight="SemiBold" Foreground="#495057" VerticalAlignment="Center"/>
                    <TextBlock Text="秒" FontSize="12" Foreground="#6C757D"
                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- 服务状态 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#28A745"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Fill" Value="#DC3545"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="服务运行中"/>
                                <Setter Property="Foreground" Value="#28A745"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Text" Value="服务未启用"/>
                                        <Setter Property="Foreground" Value="#DC3545"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 设备列表 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Devices}"
                      Margin="0">
                <DataGrid.Columns>
                    <!-- 设备ID -->
                    <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" Width="150"/>

                    <!-- 设备名称 -->
                    <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#495057"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceName}" Value="">
                                        <Setter Property="Text" Value="-"/>
                                        <Setter Property="Foreground" Value="#ADB5BD"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 设备类型 -->
                    <DataGridTextColumn Header="设备类型" Binding="{Binding DeviceType}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#495057"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceType}" Value="">
                                        <Setter Property="Text" Value="-"/>
                                        <Setter Property="Foreground" Value="#ADB5BD"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 数据Topic -->
                    <DataGridTextColumn Header="数据Topic" Binding="{Binding DataTopic}" Width="*" MinWidth="200"/>

                    <!-- 最后心跳时间 -->
                    <DataGridTextColumn Header="最后心跳" Binding="{Binding LastHeartbeatText}" Width="150"/>

                    <!-- 状态 -->
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusColor}"
                                        CornerRadius="3" Padding="8,4"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部说明 -->
        <StackPanel Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="💡 提示" FontSize="12" FontWeight="SemiBold"
                       Foreground="#495057" Margin="0,0,0,5"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#6C757D">
                <Run Text="• 设备通过发送心跳消息到 Topic:"/>
                <Run Text="{Binding HeartbeatTopic, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="进行自动注册"/>
                <LineBreak/>
                <Run Text="• 心跳消息格式: {&quot;deviceId&quot;: &quot;设备ID&quot;, &quot;dataTopic&quot;: &quot;数据Topic&quot;, &quot;deviceName&quot;: &quot;设备名称(可选)&quot;, &quot;deviceType&quot;: &quot;设备类型(可选)&quot;}"/>
                <LineBreak/>
                <Run Text="• 设备超过"/>
                <Run Text="{Binding HeartbeatTimeoutSeconds, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="秒未发送心跳将被标记为离线"/>
                <LineBreak/>
                <Run Text="• 系统会自动订阅设备的数据Topic，无需手动订阅"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
