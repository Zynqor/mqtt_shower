<Window x:Class="MqttMonitor.Views.ChartSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource ChartSettings.WindowTitle}" Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Border Margin="15" Background="White" CornerRadius="8" Padding="20"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{DynamicResource ChartSettings.Title}"
                       FontSize="18" FontWeight="Bold" Foreground="#212529" Margin="0,0,0,20"/>

            <!-- 设置表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 图表最大数据点数量 -->
                    <Label Content="{DynamicResource ChartSettings.MaxDataPoints}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding MaxChartDataPoints, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,5"/>
                    <TextBlock Text="{DynamicResource ChartSettings.MaxDataPointsHint}"
                               Foreground="#6C757D" FontSize="11" Margin="0,0,0,20"/>

                    <!-- 图表更新间隔 -->
                    <Label Content="{DynamicResource ChartSettings.UpdateInterval}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding ChartUpdateInterval, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,5"/>
                    <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource ChartSettings.UpdateIntervalHint}"
                                   Foreground="#F57C00" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- 表格每行最大列数 -->
                    <Label Content="{DynamicResource ChartSettings.MaxColumnsPerRow}" Style="{StaticResource ModernLabel}"/>
                    <TextBox Text="{Binding MaxColumnsPerRow, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,5"/>
                    <TextBlock Text="{DynamicResource ChartSettings.MaxColumnsPerRowHint}"
                               Foreground="#6C757D" FontSize="11" Margin="0,0,0,20"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{DynamicResource Settings.Save}" Width="90"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource SuccessButton}"
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Settings.Cancel}" Width="90"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
