<UserControl x:Class="MqttMonitor.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MqttMonitor.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="15,12" CornerRadius="8,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1,1,1,0">
            <TextBlock Text="{DynamicResource Log.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#212529"/>
        </Border>

        <!-- 日志列表 -->
        <Border Grid.Row="1" Background="White" CornerRadius="0,0,8,8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <TextBox x:Name="LogTextBox"
                     Text="{Binding LogsText, Mode=OneWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Padding="10"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Foreground="#495057"
                     Cursor="IBeam"/>
        </Border>
    </Grid>
</UserControl>
