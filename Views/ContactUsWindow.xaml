<Window x:Class="MqttMonitor.Views.ContactUsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource ContactUs.WindowTitle}" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    <Border Margin="15" Background="White" CornerRadius="8" Padding="25"
            BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{DynamicResource ContactUs.Title}"
                       FontSize="20" FontWeight="Bold" Foreground="#212529"
                       Margin="0,0,0,25"/>

            <!-- 联系信息 -->
            <StackPanel Grid.Row="1">
                <!-- 公司名称 -->
                <Label Content="{DynamicResource ContactUs.CompanyName}" Style="{StaticResource ModernLabel}"/>
                <TextBox Text="{Binding CompanyName, Mode=OneWay}"
                         Style="{StaticResource ReadOnlyTextBoxStyle}"
                         Height="42" Margin="0,0,0,20"
                         VerticalContentAlignment="Center"/>

                <!-- 公司地址 -->
                <Label Content="{DynamicResource ContactUs.CompanyAddress}" Style="{StaticResource ModernLabel}"/>
                <TextBox Text="{Binding CompanyAddress, Mode=OneWay}"
                         Style="{StaticResource ReadOnlyTextBoxStyle}"
                         Height="42" Margin="0,0,0,20"
                         VerticalContentAlignment="Center"/>

                <!-- 联系电话 -->
                <Label Content="{DynamicResource ContactUs.CompanyPhone}" Style="{StaticResource ModernLabel}"/>
                <TextBox Text="{Binding CompanyPhone, Mode=OneWay}"
                         Style="{StaticResource ReadOnlyTextBoxStyle}"
                         Height="42" Margin="0,0,0,20"
                         VerticalContentAlignment="Center"/>

                <!-- 电子邮箱 -->
                <Label Content="{DynamicResource ContactUs.CompanyEmail}" Style="{StaticResource ModernLabel}"/>
                <TextBox Text="{Binding CompanyEmail, Mode=OneWay}"
                         Style="{StaticResource ReadOnlyTextBoxStyle}"
                         Height="42" Margin="0,0,0,0"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- 提示文本 -->
            <Border Grid.Row="2" Background="#F0F7FF" BorderBrush="#B3D9FF" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource ContactUs.CopyHint}"
                           Foreground="#007BFF" FontSize="12" TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
