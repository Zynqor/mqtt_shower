<UserControl x:Class="MqttMonitor.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MqttMonitor.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <local:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanelColumn" Width="*" MinWidth="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition x:Name="RightPanelColumn" Width="3*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：活动告警和历史告警 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ActiveAlarmRow" Height="*" MinHeight="150"/>
                <RowDefinition Height="5"/>
                <RowDefinition x:Name="HistoryAlarmRow" Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

        <!-- 活动告警区域 -->
        <GroupBox Grid.Row="0" Header="{DynamicResource Alarm.ActiveAlarms}" Padding="10" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题和操作按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Run Text="{DynamicResource Alarm.CurrentActive}" FontWeight="Bold"/>
                        <Run Text="{Binding ActiveAlarmCount, Mode=OneWay}" Foreground="#DC3545" FontWeight="Bold" FontSize="16"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Alarm.AcknowledgeAll}" Command="{Binding AcknowledgeAllCommand}"
                                Style="{StaticResource SuccessButton}"
                                Width="90" Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>

                <!-- 活动告警列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ActiveAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DC3545" BorderThickness="1" CornerRadius="4"
                                        Padding="15" Margin="0,0,0,10" Background="#FFF5F5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：告警描述和状态 -->
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                                       Foreground="#DC3545" FontWeight="Bold"/>
                                        </Grid>

                                        <!-- 第二行：详细信息 -->
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Margin="0,0,0,5">
                                                    <Run Text="{DynamicResource Alarm.TriggerTime}"/>
                                                    <Run Text="{Binding TriggerTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,0,5">
                                                    <Run Text="{DynamicResource Alarm.CurrentValue}"/>
                                                    <Run Text="{Binding TriggerValue, StringFormat={}{0:F2}}" FontWeight="Bold" Foreground="#DC3545"/>
                                                    <Run Text="{Binding Unit}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="{DynamicResource Alarm.Threshold}"/>
                                                    <Run Text="{Binding ThresholdValue, StringFormat={}{0:F2}}" FontWeight="Bold"/>
                                                    <Run Text="{Binding Unit}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                                                <TextBlock Margin="0,0,0,5">
                                                    <Run Text="{DynamicResource Alarm.Duration}"/>
                                                    <Run Text="{Binding Duration, Mode=OneWay}" FontWeight="Bold" Foreground="#DC3545"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 第三行：操作按钮 -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button Content="{DynamicResource Alarm.Acknowledge}" Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource LightButton}"
                                                    Width="70"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 无告警提示 -->
                <TextBlock Grid.Row="1" Text="{DynamicResource DeviceList.NoActiveAlarms}" FontSize="14" Foreground="#28A745"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20"
                           Visibility="{Binding HasActiveAlarms, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
            </Grid>
        </GroupBox>

        <!-- 可拖动分隔条 -->
        <GridSplitter x:Name="VerticalSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                      Background="#E0E0E0" Cursor="SizeNS"/>

        <!-- 历史告警区域 -->
        <GroupBox Grid.Row="2" Header="{DynamicResource Alarm.HistoryAlarms}" Padding="10" Margin="0,5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 操作按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Alarm.TotalHistory}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Alarm.ClearAll}" Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource DangerButton}"
                            Width="90" HorizontalAlignment="Right"/>
                </Grid>

                <!-- 历史告警列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistoryAlarms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4"
                                        Padding="15" Margin="0,0,0,10" Background="#F8F9FA">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：告警描述和状态 -->
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓" FontSize="18" Margin="0,0,10,0" Foreground="#28A745"/>
                                                <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                                       Foreground="#28A745" FontWeight="Bold"/>
                                        </Grid>

                                        <!-- 第二行：详细信息 -->
                                        <Grid Grid.Row="1" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Margin="0,0,20,0">
                                                    <Run Text="{DynamicResource Alarm.AlarmTime}"/>
                                                    <Run Text="{Binding TriggerTime, StringFormat={}{0:MM-dd HH:mm:ss}}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,20,0">
                                                    <Run Text="{DynamicResource Alarm.RecoveryTime}"/>
                                                    <Run Text="{Binding RecoveredTime, StringFormat={}{0:MM-dd HH:mm:ss}}"/>
                                                </TextBlock>
                                                <TextBlock Margin="0,0,20,0">
                                                    <Run Text="{DynamicResource Alarm.Duration}"/>
                                                    <Run Text="{Binding Duration, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="{DynamicResource Alarm.PeakValue}"/>
                                                    <Run Text="{Binding TriggerValue, StringFormat={}{0:F2}}" FontWeight="Bold"/>
                                                    <Run Text="{Binding Unit}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </GroupBox>
        </Grid> <!-- 左侧Grid结束 -->

        <!-- 可拖动分隔条 -->
        <GridSplitter x:Name="HorizontalSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="#E0E0E0" Cursor="SizeWE"/>

        <!-- 右侧：统计面板 -->
        <Grid x:Name="StatisticsPanel" Grid.Column="2" Margin="5,0,0,0">
            <!-- AlarmStatisticsView 将通过代码后置添加 -->
        </Grid>
    </Grid>
</UserControl>
