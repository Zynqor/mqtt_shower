<UserControl x:Class="MqttMonitor.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="15,12" CornerRadius="8,8,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1,1,1,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="数据图表" FontSize="15" FontWeight="SemiBold"
                          Foreground="#212529" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="#6C757D"
                          VerticalAlignment="Center" Margin="12,0,0,0">
                    <Run Text="（实时显示最近 "/>
                    <Run Text="{Binding MaxChartDataPoints}"/>
                    <Run Text=" 个数据点）"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 主内容区域 -->
        <Border Grid.Row="1" Background="White" CornerRadius="0,0,8,8"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- ScottPlot 图表 -->
                <scottplot:WpfPlot x:Name="ChartControl" Grid.Column="0"
                                   Background="White"
                                   Margin="10"/>

                <!-- 图例列表 -->
                <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#E0E0E0"
                        BorderThickness="1,0,0,0" Padding="15">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="图例" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#212529" Margin="0,0,0,15"/>

                        <ScrollViewer DockPanel.Dock="Top"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding LegendGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                BorderBrush="#DEE2E6"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,10">
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      Background="Transparent"
                                                      BorderThickness="0">
                                                <Expander.Header>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 设备ID -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DeviceId, StringFormat='设备: {0}'}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#212529"
                                                                   VerticalAlignment="Center"
                                                                   Margin="5,0,0,0"/>

                                                        <!-- 复选框 -->
                                                        <CheckBox Grid.Column="1"
                                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="10,0,5,0"
                                                                  ToolTip="勾选以在图表中显示此设备"/>
                                                    </Grid>
                                                </Expander.Header>

                                            <!-- 展开后显示的内容 -->
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="10,5,10,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F8F9FA"
                                                                BorderBrush="#CED4DA"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="10"
                                                                Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- 颜色块 -->
                                                                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                                                                        Width="20" Height="60" CornerRadius="3"
                                                                        Background="{Binding ColorHex}"
                                                                        Margin="0,0,10,0"/>

                                                                <!-- 参数名 -->
                                                                <TextBlock Grid.Column="1" Grid.Row="0"
                                                                           Text="{Binding ParameterName, StringFormat='参数: {0}'}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#495057"
                                                                           Margin="0,0,0,6"/>

                                                                <!-- 颜色输入 -->
                                                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                                                                    <TextBlock Text="颜色: " FontSize="10" Foreground="#495057"
                                                                               VerticalAlignment="Center" Width="45"/>
                                                                    <TextBox Text="{Binding ColorHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             Width="75" FontSize="10" Height="26"
                                                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                                             Padding="5,3" BorderBrush="#CED4DA"
                                                                             KeyDown="TextBox_KeyDown"/>
                                                                </StackPanel>

                                                                <!-- 偏移量输入 -->
                                                                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal">
                                                                    <TextBlock Text="偏移量: " FontSize="10" Foreground="#495057"
                                                                               VerticalAlignment="Center" Width="45"/>
                                                                    <TextBox Text="{Binding Offset, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             Width="75" FontSize="10" Height="26"
                                                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                                             Padding="5,3" BorderBrush="#CED4DA"
                                                                             KeyDown="TextBox_KeyDown"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
