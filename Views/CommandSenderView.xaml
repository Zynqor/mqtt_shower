<UserControl x:Class="MqttMonitor.Views.CommandSenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <!-- 资源 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 发送按钮样式 -->
        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E7E34"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 清空按钮样式 -->
        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#BD2130"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 命令发送区 -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                          Text="{DynamicResource Command.Title}" FontSize="16" FontWeight="SemiBold"
                          Foreground="#212529" Margin="0,0,0,20"/>

                <!-- 设备ID -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                          Text="{DynamicResource Command.TargetDevice}" VerticalAlignment="Center"
                          Foreground="#495057" FontSize="13" Margin="0,0,10,12"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                         ItemsSource="{Binding DeviceList}"
                         SelectedItem="{Binding SelectedDevice}"
                         Height="36" Margin="0,0,0,12"
                         FontSize="13"
                         BorderBrush="#CED4DA"
                         BorderThickness="1"
                         Background="White"
                         VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,3">
                                <TextBlock Text="{Binding DeviceId}" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#212529" VerticalAlignment="Center"/>
                                <TextBlock Text="-" Foreground="#6C757D" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DeviceName}" Foreground="#495057" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="[" Foreground="#6C757D" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#DC3545"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Foreground" Value="#28A745"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="]" Foreground="#6C757D" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 选择命令 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                          Text="{DynamicResource Command.SelectOperation}" VerticalAlignment="Center"
                          Foreground="#495057" FontSize="13" Margin="0,0,10,12"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                         ItemsSource="{Binding CommandTemplates}"
                         SelectedItem="{Binding SelectedCommandTemplate}"
                         DisplayMemberPath="Description"
                         Height="36" Margin="0,0,0,20"
                         FontSize="13"
                         Padding="8,6"
                         VerticalContentAlignment="Center"/>

                <!-- 说明文本 -->
                <TextBlock Grid.Row="3" Grid.Column="1"
                          Text="{DynamicResource Command.Description}"
                          TextWrapping="Wrap" Foreground="#6C757D" FontSize="11"
                          Margin="0,0,0,15"/>

                <!-- 发送按钮 -->
                <Button Grid.Row="5" Grid.Column="1"
                       Content="{DynamicResource Command.SendButton}" Command="{Binding SendCommandCommand}"
                       Width="130" HorizontalAlignment="Left" Height="36"
                       Style="{StaticResource SendButton}"/>
            </Grid>
        </Border>

        <!-- 历史记录区 -->
        <Grid Grid.Row="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 历史记录标题栏 -->
            <Border Grid.Row="0" Background="White" Padding="15,12" CornerRadius="8,8,0,0"
                    BorderBrush="#E0E0E0" BorderThickness="1,1,1,0">
                <Grid>
                    <TextBlock Text="{DynamicResource Command.HistoryTitle}" FontSize="15" FontWeight="SemiBold"
                              Foreground="#212529" VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Command.ClearHistory}" Command="{Binding ClearHistoryCommand}"
                           HorizontalAlignment="Right" Width="90" Height="32"
                           Style="{StaticResource ClearButton}"/>
                </Grid>
            </Border>

            <!-- 历史记录列表 -->
            <Border Grid.Row="1" Background="White" CornerRadius="0,0,8,8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <DataGrid ItemsSource="{Binding CommandHistory}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         CanUserResizeRows="False"
                         HeadersVisibility="Column"
                         GridLinesVisibility="Horizontal"
                         AlternatingRowBackground="#F8F9FA"
                         Background="White"
                         BorderThickness="0"
                         RowHeight="35"
                         ColumnHeaderHeight="40"
                         HorizontalGridLinesBrush="#E9ECEF"
                         MouseDoubleClick="CommandHistory_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#495057"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderBrush" Value="#DEE2E6"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="#212529"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E7F3FF"/>
                                    <Setter Property="Foreground" Value="#212529"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F3F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Command.History.Time}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Time" StringFormat="yyyy-MM-dd HH:mm:ss"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Command.History.DeviceId}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="DeviceId"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Command.History.CommandName}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="CommandName"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="200">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Command.History.CommandId}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="CommandId"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Command.History.Status}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Status"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="150">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Command.History.ResponseTime}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="ResponseTime" StringFormat="yyyy-MM-dd HH:mm:ss"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="*">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{DynamicResource Command.History.Result}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.Binding>
                                <Binding Path="Result"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
