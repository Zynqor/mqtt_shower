<Window x:Class="MqttMonitor.Views.AlarmConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MqttMonitor.ViewModels"
        xmlns:converters="clr-namespace:MqttMonitor.Converters"
        mc:Ignorable="d"
        Title="告警配置" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：设备/测点树 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="设备/测点列表" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TreeView Grid.Row="1" ItemsSource="{Binding DeviceGroups}" BorderBrush="#CED4DA" BorderThickness="1">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:DeviceMetricGroup}" ItemsSource="{Binding Metrics}">
                        <TextBlock Text="{Binding DeviceId}" FontWeight="Bold"/>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceMetricItem}">
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                        <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Content="全部启用" Command="{Binding EnableAllCommand}" Height="30" Margin="0,0,0,5"/>
                <Button Content="全部禁用" Command="{Binding DisableAllCommand}" Height="30"/>
            </StackPanel>
        </Grid>

        <!-- 右侧：告警参数设置 -->
        <Grid Grid.Column="1" Margin="15,0,0,0">
            <!-- 未选中测点时的提示 -->
            <TextBlock Text="← 请在左侧选择一个测点以配置告警参数"
                       FontSize="13" Foreground="#6C757D"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding CurrentConfig, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- 选中测点后的配置面板 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding CurrentConfig, Converter={StaticResource NotNullToVisibilityConverter}}">
                <StackPanel DataContext="{Binding CurrentConfig}">
                    <TextBlock Text="告警参数设置" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <CheckBox Content="启用告警" IsChecked="{Binding Enabled}" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>

                    <!-- 上限告警 -->
                    <GroupBox Header="上限告警" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <CheckBox Content="启用上限告警" IsChecked="{Binding EnableUpperLimit}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="上限值:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding UpperLimit, UpdateSourceTrigger=PropertyChanged}"
                                         Width="150" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 下限告警 -->
                    <GroupBox Header="下限告警" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <CheckBox Content="启用下限告警" IsChecked="{Binding EnableLowerLimit}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="下限值:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding LowerLimit, UpdateSourceTrigger=PropertyChanged}"
                                         Width="150" Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 持续时长 -->
                    <GroupBox Header="持续时长设置" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <TextBlock Text="避免瞬时波动触发告警" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="持续时长:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" Height="30" VerticalContentAlignment="Center"/>
                                <TextBlock Text="秒" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 通知方式 -->
                    <GroupBox Header="通知方式" Margin="0,0,0,15" Padding="10">
                        <StackPanel>
                            <CheckBox Content="视觉提醒 (表格变红+闪烁)" IsChecked="{Binding EnableVisualAlert}" Margin="0,0,0,10"/>
                            <CheckBox Content="声音提醒" IsChecked="{Binding EnableSoundAlert}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="重复间隔:" VerticalAlignment="Center" Width="80"/>
                                <TextBox Text="{Binding SoundRepeatMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" Height="30" VerticalContentAlignment="Center"/>
                                <TextBlock Text="分钟" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="告警音每隔N分钟重复提醒，直到用户确认或告警恢复"
                                       Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="保存" Width="80" Height="30" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0"/>
                        <Button Content="取消" Width="80" Height="30" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
