<Window x:Class="MqttMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MqttMonitor"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <!-- 资源 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 按钮样式 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004085"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCC"/>
                    <Setter Property="Foreground" Value="#666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4E555B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl样式 -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="Transparent"
                                BorderThickness="0,0,0,3" BorderBrush="Transparent"
                                Padding="20,10" Margin="0,0,5,0">
                            <ContentPresenter x:Name="ContentSite"
                                            ContentSource="Header"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007BFF"/>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#495057"/>
        </Style>

        <!-- TextBox样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)" Padding="10,5">
                <MenuItem Header="MQTT 连接设置(_S)" Command="{Binding ShowSettingsCommand}"/>
                <MenuItem Header="图表设置(_C)" Command="{Binding ShowChartSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)" Padding="10,5">
                <MenuItem Header="联系我们(_C)" Command="{Binding ShowContactUsCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Height="40">
            <StatusBarItem>
                <TextBlock Text="连接状态:" Foreground="#6C757D" FontSize="12"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="Bold" FontSize="12"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar Width="100" Height="16"
                             IsIndeterminate="True"
                             Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="连接" Width="70" Margin="5,0"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding ConnectCommand}"/>
                    <Button Content="断开" Width="70" Margin="0,0,5,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding DisconnectCommand}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 主内容区域 -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：TabControl -->
            <TabControl Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem x:Name="ChartTabItem" Header="图表视图">
                    <!-- ChartView 将通过代码后置添加 -->
                </TabItem>
                <TabItem x:Name="TableTabItem" Header="表格视图">
                    <!-- TableView 将通过代码后置添加 -->
                </TabItem>
                <TabItem x:Name="CommandSenderTabItem" Header="命令发送">
                    <!-- CommandSenderView 将通过代码后置添加 -->
                </TabItem>
                <TabItem x:Name="LogTabItem" Header="日志">
                    <!-- LogView 将通过代码后置添加 -->
                </TabItem>
            </TabControl>

            <!-- 分隔符 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 右侧：Topic 订阅管理 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="0" Text="Topic 订阅管理" FontSize="15" FontWeight="SemiBold"
                               Foreground="#212529" Margin="0,0,0,15"/>

                    <!-- 订阅输入 -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="订阅新 Topic:" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#495057" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding NewTopic, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" Margin="0,0,0,8"/>
                        <TextBlock Text="支持通配符: + (单层) 和 # (多层)"
                                   Foreground="#6C757D" FontSize="11" Margin="0,0,0,10"/>
                        <Button Content="订阅" Command="{Binding SubscribeTopicCommand}"
                                Height="32" Style="{StaticResource ModernButton}"/>
                    </StackPanel>

                    <!-- 已订阅列表 -->
                    <DockPanel Grid.Row="2">
                        <TextBlock DockPanel.Dock="Top" Text="已订阅的 Topics:" FontWeight="SemiBold"
                                   FontSize="12" Foreground="#495057" Margin="0,0,0,8"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                            <ListBox ItemsSource="{Binding SubscribedTopics}"
                                     SelectedItem="{Binding SelectedTopic}"
                                     x:Name="TopicsListBox"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="5" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>

                    <!-- 取消订阅按钮 -->
                    <Button Grid.Row="3" Content="取消订阅选中项" Margin="0,15,0,0" Height="32"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding UnsubscribeTopicCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=TopicsListBox}"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
