<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 菜单栏 -->
    <sys:String x:Key="Menu.File">文件(_F)</sys:String>
    <sys:String x:Key="Menu.File.MqttSettings">MQTT 连接设置(_S)</sys:String>
    <sys:String x:Key="Menu.File.ChartSettings">图表设置(_C)</sys:String>
    <sys:String x:Key="Menu.File.Exit">退出(_X)</sys:String>

    <sys:String x:Key="Menu.Device">设备(_D)</sys:String>
    <sys:String x:Key="Menu.Device.Management">设备管理(_M)</sys:String>

    <sys:String x:Key="Menu.Monitor">数据监控(_M)</sys:String>
    <sys:String x:Key="Menu.Monitor.HistoryQuery">历史数据查询(_H)</sys:String>
    <sys:String x:Key="Menu.Monitor.AlarmHistory">历史告警查询(_L)</sys:String>
    <sys:String x:Key="Menu.Monitor.AlarmConfig">告警配置(_A)</sys:String>
    <sys:String x:Key="Menu.Monitor.AlertSettings">提醒设置(_S)</sys:String>

    <sys:String x:Key="Menu.Help">帮助(_H)</sys:String>
    <sys:String x:Key="Menu.Help.UserManual">使用说明(_U)</sys:String>
    <sys:String x:Key="Menu.Help.ContactUs">联系我们(_C)</sys:String>
    <sys:String x:Key="Menu.Help.Language">语言(_L)</sys:String>
    <sys:String x:Key="Menu.Help.Language.Chinese">中文</sys:String>
    <sys:String x:Key="Menu.Help.Language.English">English</sys:String>

    <!-- 状态栏 -->
    <sys:String x:Key="Status.Connection">连接状态:</sys:String>
    <sys:String x:Key="Status.OnlineDevices">在线设备:</sys:String>
    <sys:String x:Key="Status.TotalDevices">总设备数:</sys:String>
    <sys:String x:Key="Status.Connect">连接</sys:String>
    <sys:String x:Key="Status.Disconnect">断开</sys:String>

    <!-- 主页面选项卡 -->
    <sys:String x:Key="Tab.ChartView">图表视图</sys:String>
    <sys:String x:Key="Tab.TableView">表格视图</sys:String>
    <sys:String x:Key="Tab.CommandSender">命令发送</sys:String>
    <sys:String x:Key="Tab.Alarm">告警</sys:String>
    <sys:String x:Key="Tab.Log">日志</sys:String>

    <!-- Topic订阅管理 -->
    <sys:String x:Key="Topic.Title">Topic 订阅管理</sys:String>
    <sys:String x:Key="Topic.SubscribeNew">订阅新 Topic:</sys:String>
    <sys:String x:Key="Topic.Subscribe">订阅</sys:String>
    <sys:String x:Key="Topic.SubscribedList">已订阅的 Topics:</sys:String>
    <sys:String x:Key="Topic.UnsubscribeSelected">取消订阅选中项</sys:String>

    <!-- 命令发送页面 -->
    <sys:String x:Key="Command.Title">命令发送（极简版）</sys:String>
    <sys:String x:Key="Command.TargetDevice">目标设备:</sys:String>
    <sys:String x:Key="Command.SelectOperation">选择操作:</sys:String>
    <sys:String x:Key="Command.Description">选择操作后直接点击发送，所有参数已预配置</sys:String>
    <sys:String x:Key="Command.SendButton">发送命令</sys:String>
    <sys:String x:Key="Command.HistoryTitle">命令历史记录</sys:String>
    <sys:String x:Key="Command.ClearHistory">清空记录</sys:String>

    <!-- 命令历史表格列 -->
    <sys:String x:Key="Command.History.Time">时间</sys:String>
    <sys:String x:Key="Command.History.DeviceId">设备ID</sys:String>
    <sys:String x:Key="Command.History.CommandName">命令名称</sys:String>
    <sys:String x:Key="Command.History.CommandId">命令ID</sys:String>
    <sys:String x:Key="Command.History.Status">状态</sys:String>
    <sys:String x:Key="Command.History.ResponseTime">响应时间</sys:String>
    <sys:String x:Key="Command.History.Result">返回结果</sys:String>

    <!-- 通用按钮 -->
    <sys:String x:Key="Button.OK">确定</sys:String>
    <sys:String x:Key="Button.Cancel">取消</sys:String>
    <sys:String x:Key="Button.Apply">应用</sys:String>
    <sys:String x:Key="Button.Close">关闭</sys:String>
    <sys:String x:Key="Button.Save">保存</sys:String>

    <!-- 消息提示 -->
    <sys:String x:Key="Message.Success">成功</sys:String>
    <sys:String x:Key="Message.Error">错误</sys:String>
    <sys:String x:Key="Message.Warning">警告</sys:String>
    <sys:String x:Key="Message.Info">提示</sys:String>

    <!-- 图表视图 -->
    <sys:String x:Key="Chart.Title">数据图表</sys:String>
    <sys:String x:Key="Chart.RealtimePoints">（实时显示最近</sys:String>
    <sys:String x:Key="Chart.DataPoints">个数据点）</sys:String>
    <sys:String x:Key="Chart.Legend">图例</sys:String>
    <sys:String x:Key="Chart.Device">设备:</sys:String>
    <sys:String x:Key="Chart.ShowHide">显示/隐藏</sys:String>

    <!-- 表格视图 -->
    <sys:String x:Key="Table.Title">设备数据表格</sys:String>

    <!-- 日志视图 -->
    <sys:String x:Key="Log.Title">系统日志</sys:String>

    <!-- 告警视图 -->
    <sys:String x:Key="Alarm.ActiveAlarms">活动告警</sys:String>
    <sys:String x:Key="Alarm.HistoryAlarms">历史告警</sys:String>
    <sys:String x:Key="Alarm.CurrentActive">当前活动告警:</sys:String>
    <sys:String x:Key="Alarm.AcknowledgeAll">全部确认</sys:String>
    <sys:String x:Key="Alarm.TriggerTime">触发时间：</sys:String>
    <sys:String x:Key="Alarm.CurrentValue">当前值：</sys:String>
    <sys:String x:Key="Alarm.Threshold">阈值：</sys:String>
    <sys:String x:Key="Alarm.Duration">持续时长：</sys:String>
    <sys:String x:Key="Alarm.DeviceId">设备ID：</sys:String>
    <sys:String x:Key="Alarm.DataKey">数据键：</sys:String>
    <sys:String x:Key="Alarm.Acknowledge">确认</sys:String>
    <sys:String x:Key="Alarm.Detail">详情</sys:String>
    <sys:String x:Key="Alarm.TotalHistory">历史告警总数:</sys:String>
    <sys:String x:Key="Alarm.ClearAll">全部清空</sys:String>
    <sys:String x:Key="Alarm.AlarmTime">告警时间：</sys:String>
    <sys:String x:Key="Alarm.RecoveryTime">恢复时间：</sys:String>
    <sys:String x:Key="Alarm.PeakValue">峰值：</sys:String>

    <!-- 告警统计视图 -->
    <sys:String x:Key="AlarmStats.TimeRange">时间范围</sys:String>
    <sys:String x:Key="AlarmStats.Today">今天</sys:String>
    <sys:String x:Key="AlarmStats.Last7Days">最近7天</sys:String>
    <sys:String x:Key="AlarmStats.Last30Days">最近30天</sys:String>
    <sys:String x:Key="AlarmStats.StartTime">开始时间：</sys:String>
    <sys:String x:Key="AlarmStats.EndTime">结束时间：</sys:String>
    <sys:String x:Key="AlarmStats.Query">查询</sys:String>
    <sys:String x:Key="AlarmStats.Loading">正在加载统计数据...</sys:String>
    <sys:String x:Key="AlarmStats.AlarmCount">告警次数</sys:String>
    <sys:String x:Key="AlarmStats.AlarmDuration">告警时长</sys:String>
    <sys:String x:Key="AlarmStats.AlarmTrend">告警趋势</sys:String>
    <sys:String x:Key="AlarmStats.TypeDistribution">类型分布</sys:String>
    <sys:String x:Key="AlarmStats.TopDevices">Top设备</sys:String>
    <sys:String x:Key="AlarmStats.Rank">排名</sys:String>
    <sys:String x:Key="AlarmStats.DeviceId">设备ID</sys:String>
    <sys:String x:Key="AlarmStats.MetricName">测点名称</sys:String>
    <sys:String x:Key="AlarmStats.AlarmCountColumn">告警次数</sys:String>
    <sys:String x:Key="AlarmStats.AvgDuration">平均持续</sys:String>
    <sys:String x:Key="AlarmStats.NoData">暂无数据</sys:String>

</ResourceDictionary>
